<Window x:Class="FocusDesktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="focus-desktop"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        Background="{DynamicResource Brush.Bg}"
        Focusable="True"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <Style x:Key="NavBtn" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource Brush.Panel}"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="28,14"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 顶栏：时间 + DEV 角标 + 退出 -->
        <Border Grid.Row="0" Background="{DynamicResource Brush.Panel}"
                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1" Padding="24,10">
            <Grid>
                <TextBlock x:Name="TimeText" Text="--:--:--" FontSize="16"
                           Foreground="{DynamicResource Brush.TextDim}" VerticalAlignment="Center"/>
                <TextBlock x:Name="DevBadge" Text="DEV" FontSize="12" FontWeight="Bold"
                           Foreground="{DynamicResource Brush.Danger}" Margin="120,0,0,0"
                           VerticalAlignment="Center" Visibility="Collapsed"/>
                <Button x:Name="ExitButton" Content="退出" HorizontalAlignment="Right"
                        Background="Transparent" Foreground="{DynamicResource Brush.TextDim}"
                        BorderThickness="0" FontSize="14" Cursor="Hand" Click="ExitButton_Click"/>
            </Grid>
        </Border>

        <!-- 主区：计时器大数字 + 导航按钮 -->
        <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock x:Name="TimerBig" Text="00:00:00" FontSize="96" FontWeight="Light"
                       Foreground="{DynamicResource Brush.Text}"
                       HorizontalAlignment="Center"/>
            <TextBlock x:Name="TimerHint" Text="正计时 · 空格开始/暂停" FontSize="14"
                       Foreground="{DynamicResource Brush.TextDim}" HorizontalAlignment="Center"
                       Margin="0,4,0,48"/>
            <WrapPanel HorizontalAlignment="Center">
                <Button Style="{StaticResource NavBtn}" Content="学习文件" Margin="6"/>
                <Button Style="{StaticResource NavBtn}" Content="Bilibili" Margin="6"/>
                <Button Style="{StaticResource NavBtn}" Content="ChatGPT" Margin="6"/>
                <Button Style="{StaticResource NavBtn}" Content="Gemini" Margin="6"/>
                <Button Style="{StaticResource NavBtn}" Content="DeepSeek" Margin="6"/>
            </WrapPanel>
        </StackPanel>

        <!-- 底部：状态条 -->
        <Border Grid.Row="2" Background="{DynamicResource Brush.Panel}"
                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0" Padding="24,8">
            <TextBlock x:Name="StatusText" Text="focus-desktop v0.1 · Step 1+2 构建中"
                       FontSize="12" Foreground="{DynamicResource Brush.TextDim}"/>
        </Border>
    </Grid>
</Window>
