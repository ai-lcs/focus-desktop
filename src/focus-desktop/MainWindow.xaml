<Window x:Class="focus_desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="focus-desktop"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        ShowActivated="True"
        WindowStartupLocation="Manual"
        Background="{DynamicResource BgBrush}"
        Foreground="{DynamicResource FgBrush}"
        UseLayoutRounding="True">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 顶栏：时间 | DEV 角标 | 退出 -->
        <Border Grid.Row="0" Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="20,0">
                <TextBlock x:Name="ClockText" Text="00:00:00"
                           FontSize="18" FontFamily="Consolas"
                           VerticalAlignment="Center" HorizontalAlignment="Left"
                           Foreground="{DynamicResource FgBrush}"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Border x:Name="DevBadge" Background="#5F5B00" CornerRadius="4" Padding="8,2" Margin="0,0,12,0"
                            Visibility="Collapsed">
                        <TextBlock Text="DEV" FontSize="12" FontWeight="Bold" Foreground="#FDD663"/>
                    </Border>
                    <Button x:Name="ExitButton" Content="退出"
                            FontSize="14" Padding="16,6"
                            Background="Transparent"
                            Foreground="{DynamicResource DangerBrush}"
                            BorderBrush="{DynamicResource DangerBrush}" BorderThickness="1"
                            Cursor="Hand" Click="ExitButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 主区：Step 1+2 的占位内容 = 停点①实测清单 -->
        <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="640">
            <TextBlock Text="focus-desktop" FontSize="40" FontWeight="Bold"
                       HorizontalAlignment="Center" Foreground="{DynamicResource AccentBrush}"/>
            <TextBlock Text="专注学习环境 · Step 1+2 壳层" FontSize="16" Margin="0,8,0,36"
                       HorizontalAlignment="Center" Foreground="{DynamicResource MutedBrush}"/>

            <Border Background="{DynamicResource PanelBrush}" CornerRadius="8" Padding="24"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="停点①实测清单" FontSize="16" FontWeight="Bold" Margin="0,0,0,12"/>
                    <TextBlock Text="按 Win 键 —— 开始菜单不应弹出" FontSize="14" Margin="0,4"/>
                    <TextBlock Text="按 Alt+Tab —— 不应切到其他应用" FontSize="14" Margin="0,4"/>
                    <TextBlock Text="按 Alt+F4 —— 本窗口不应关闭" FontSize="14" Margin="0,4"/>
                    <TextBlock Text="按 Ctrl+Shift+Esc —— 任务管理器【应该】能打开（救生通道）" FontSize="14" Margin="0,4"/>
                    <TextBlock Text="按 Esc —— 本软件不处理（留给网页全屏退出，Step 3 验证）" FontSize="14" Margin="0,4"/>
                    <TextBlock Text="任务栏 —— 当前应为隐藏状态" FontSize="14" Margin="0,4"/>
                    <TextBlock Text="点右下角退出 —— 任务栏应恢复（本阶段免退出文本，Step 6 上线）"
                               FontSize="14" Margin="0,4"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</Window>
