<Window x:Class="focus_desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:focus_desktop"
        Title="focus-desktop"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        ShowActivated="True"
        WindowStartupLocation="Manual"
        Background="{DynamicResource BgBrush}"
        Foreground="{DynamicResource FgBrush}"
        UseLayoutRounding="True">

    <Window.Resources>
        <!-- 舒适背景：暖夜色渐变（深而不黑，柔和） -->
        <LinearGradientBrush x:Key="ComfortBg" StartPoint="0.1,0" EndPoint="0.9,1">
            <GradientStop Color="#23262C" Offset="0"/>
            <GradientStop Color="#2B2F37" Offset="0.55"/>
            <GradientStop Color="#31353E" Offset="1"/>
        </LinearGradientBrush>
        <!-- 卡片：比背景亮一档 + 细边框（保证可见对比） -->
        <LinearGradientBrush x:Key="CardBg" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#3E434D" Offset="0"/>
            <GradientStop Color="#353A43" Offset="1"/>
        </LinearGradientBrush>
    </Window.Resources>

    <Grid Background="{StaticResource ComfortBg}">
        <Grid.RowDefinitions>
            <RowDefinition Height="44"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 顶栏：Tab 条 | 音量 | DEV | 退出（时间已移到首页大钟） -->
        <Border Grid.Row="0" Background="#26292E"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Tab 条（浏览器式：「+」在滚动流内紧跟最后一个 tab，用户 2026-08-31 指示） -->
                <ScrollViewer Grid.Column="0" HorizontalScrollBarVisibility="Hidden"
                              VerticalScrollBarVisibility="Disabled">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" x:Name="TabBar"/>
                </ScrollViewer>

                <!-- 音量：胶囊（静音键 + 细滑轨 + 百分比） -->
                <Border Grid.Column="1" Background="#1F2226" CornerRadius="14" Padding="10,4" Margin="0,0,12,0"
                        VerticalAlignment="Center" BorderBrush="#3A3F46" BorderThickness="1">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="MuteButton" Content="🔊" FontSize="13" Padding="2" Margin="0,0,6,0"
                                Background="Transparent" BorderThickness="0" Cursor="Hand"
                                Foreground="{DynamicResource FgBrush}" Click="MuteButton_Click"/>
                        <Slider x:Name="VolumeSlider" Width="80" Minimum="0" Maximum="100"
                                VerticalAlignment="Center" Style="{StaticResource SlimSlider}"
                                ValueChanged="VolumeSlider_ValueChanged"/>
                        <TextBlock x:Name="VolumePct" Text="50" FontSize="11" MinWidth="24" TextAlignment="Right"
                                   VerticalAlignment="Center" Margin="6,0,2,0"
                                   Foreground="{DynamicResource MutedBrush}"/>
                    </StackPanel>
                </Border>

                <!-- DEV + 退出 -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border x:Name="DevBadge" Background="#5F5B00" CornerRadius="4" Padding="8,2" Margin="0,0,12,0"
                            Visibility="Collapsed">
                        <TextBlock x:Name="DevBadgeText" Text="DEV" FontSize="12" FontWeight="Bold" Foreground="#FDD663"/>
                    </Border>
                    <Button x:Name="ExitButton" Content="退出"
                            FontSize="13" Padding="14,5"
                            Background="Transparent"
                            Foreground="{DynamicResource DangerBrush}"
                            BorderBrush="{DynamicResource DangerBrush}" BorderThickness="1"
                            Cursor="Hand" Click="ExitButton_Click"/>
                    <TextBlock x:Name="TopClock" Text="--:--" FontSize="14" FontFamily="Consolas"
                               VerticalAlignment="Center" Margin="14,0,0,0"
                               Foreground="{DynamicResource FgBrush}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 主区 -->
        <Grid Grid.Row="1">

            <!-- Home：左钟右卡，紧凑双栏 -->
            <Grid x:Name="HomeView" Margin="36,24,36,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.15*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <!-- 首页背景图（用户向导选图；很浅+暗化保证 UI 可读；加载成功才可见） -->
                <Image x:Name="HomeBgImage" Grid.ColumnSpan="2"
                       Stretch="UniformToFill" StretchDirection="Both"
                       Opacity="0.22" IsHitTestVisible="False" Visibility="Collapsed"/>
                <Border x:Name="HomeBgMask" Grid.ColumnSpan="2"
                        Background="#99000000" IsHitTestVisible="False" Visibility="Collapsed"/>

                <!-- 左列：时钟 + 日期 + 专注语卡片 + 快捷入口（紧凑分组，消除空洞感） -->
                <StackPanel Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="480">
                    <TextBlock x:Name="BigClock" Text="00:00"
                               FontSize="72" FontWeight="Light" FontFamily="Consolas"
                               Foreground="#F0F4FF" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="ClockDate" Text="—" FontSize="15" HorizontalAlignment="Center"
                               Margin="0,0,0,18" Foreground="#9AA0A6"/>
                    <!-- 专注语卡片（金色引言，桌面番茄钟同款语言） -->
                    <Border Background="#333842" CornerRadius="10" BorderBrush="#4A505A" BorderThickness="1"
                            Padding="20,14" Margin="0,0,0,22" MaxWidth="440">
                        <TextBlock x:Name="FocusQuote" Text="你想成为怎样的人？"
                                   FontSize="18" FontWeight="Medium" HorizontalAlignment="Center" TextWrapping="Wrap"
                                   Foreground="#F5C542" TextAlignment="Center" LineHeight="30"/>
                    </Border>
                    <!-- 快捷入口：站点按钮由代码按配置动态生成（Public v1 数据驱动），学习文件独立第二行 -->
                    <WrapPanel x:Name="HomeSitesPanel" HorizontalAlignment="Center">
                    </WrapPanel>
                    <Button Style="{StaticResource NavBtn}" Content="📂 学习文件" FontSize="14" Padding="30,10"
                            HorizontalAlignment="Center" Margin="0,10,0,0" Click="Nav_Files_Click"/>
                </StackPanel>

                <!-- 右列：计时器卡片 + 番茄钟卡片（拉伸铺满列高，修右下空洞） -->
                <Grid Grid.Column="1" Margin="12,0,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 卡片1：自由计时器 -->
                    <Border Grid.Row="0" Background="{StaticResource CardBg}" CornerRadius="14"
                            BorderBrush="#4A505A" BorderThickness="1"
                            Padding="24,16" Margin="0,0,0,16">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="计时器" FontSize="13" Foreground="#9AA0A6"/>
                                <TextBlock x:Name="TimerHint" Text="空格 开始/暂停" FontSize="11"
                                           Foreground="#6B7076" HorizontalAlignment="Right"/>
                            </Grid>
                            <TextBlock x:Name="TimerBig" Text="00:00:00" FontSize="46" FontWeight="Light"
                                       FontFamily="Consolas" HorizontalAlignment="Center" Foreground="#F0F4FF"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,0">
                                <Button x:Name="TimerBtnToggle" Content="开始" Style="{StaticResource NavBtn}"
                                        Padding="16,7" FontSize="12" Margin="0,0,8,0" Click="Timer_Toggle_Click"/>
                                <Button x:Name="TimerBtnReset" Content="重置" Style="{StaticResource NavBtn}"
                                        Padding="16,7" FontSize="12" Click="Timer_Reset_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- 卡片2：番茄钟（占满剩余高度，内容垂直居中；padding 收紧防环-框大空位） -->
                    <Border Grid.Row="1" Background="{StaticResource CardBg}" CornerRadius="14"
                            BorderBrush="#4A505A" BorderThickness="1"
                            Padding="10,8">
                        <local:PomodoroControl x:Name="PomoControl" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Border>
                </Grid>
            </Grid>

            <!-- 学习文件 -->
            <Grid x:Name="FilesView" Visibility="Collapsed" Margin="24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button Content="← 返回" Grid.Column="0" Style="{StaticResource NavBtn}" Padding="14,6" FontSize="13"
                            Click="Files_Back_Click"/>
                    <Button Content="🏠 根目录" Grid.Column="1" Style="{StaticResource NavBtn}" Padding="14,6" FontSize="13" Margin="8,0,0,0"
                            Click="Files_Root_Click"/>
                    <TextBlock x:Name="FilesPath" Grid.Column="2" Text="…" FontSize="13" FontFamily="Consolas"
                               VerticalAlignment="Center" Margin="14,0"
                               Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis"/>
                    <TextBox x:Name="SearchBox" Grid.Column="3" Width="200" FontSize="14" Padding="8,6"
                             VerticalContentAlignment="Center" TextChanged="SearchBox_TextChanged"
                             Background="{DynamicResource PanelBrush}"
                             Foreground="{DynamicResource FgBrush}"
                             BorderBrush="{DynamicResource BorderBrush}"/>
                </Grid>
                <ListBox x:Name="FileList" Grid.Row="1" Background="Transparent"
                         BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VirtualizingStackPanel.IsVirtualizing="True"
                         VirtualizingStackPanel.VirtualizationMode="Recycling">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="HorizontalContentAlignment" Value="Left"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter/>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </Grid>

            <!-- WebView 宿主 -->
            <Grid x:Name="WebHost" Visibility="Collapsed">
                <WindowsFormsHost x:Name="WfHost" Background="Transparent"/>
            </Grid>
            </Grid>

            <!-- 被拦截提示条 -->
        <Border x:Name="BlockedBar" Grid.Row="1" VerticalAlignment="Top" HorizontalAlignment="Center"
                Background="#5C1F1F" BorderBrush="#E5534B" BorderThickness="1" CornerRadius="6"
                Padding="16,8" Margin="0,12,0,0" Visibility="Collapsed">
            <TextBlock x:Name="BlockedText" Text="" FontSize="13" Foreground="#FAD2CF"/>
        </Border>
    </Grid>
</Window>
