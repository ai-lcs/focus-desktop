<Window x:Class="focus_desktop.ExitWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="确认离开专注环境"
        AutomationProperties.AutomationId="ExitWindow"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Width="560"
        Height="400"
        WindowStartupLocation="Manual"
        Background="{DynamicResource PanelBrush}"
        Foreground="{DynamicResource FgBrush}">
    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="32,28">
        <StackPanel>
            <TextBlock Text="确认离开专注环境" FontSize="20" FontWeight="Bold" Margin="0,0,0,8"/>
            <TextBlock Text="请完整输入以下句子以退出（Esc 取消）：" FontSize="14"
                       Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,12"/>
            <Border Background="{DynamicResource BgBrush}" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                <TextBlock x:Name="PhraseText" Text="" FontSize="15" TextWrapping="Wrap"
                           Foreground="{DynamicResource AccentBrush}"/>
            </Border>
            <TextBox x:Name="InputBox" FontSize="15" Padding="10,8"
                     Background="{DynamicResource BgBrush}"
                     Foreground="{DynamicResource FgBrush}"
                     BorderBrush="{DynamicResource BorderBrush}"/>
            <TextBlock x:Name="ErrorText" Text="" FontSize="12"
                       Foreground="{DynamicResource DangerBrush}" Margin="0,8,0,0"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Content="留在这里" Style="{StaticResource NavBtn}" Padding="16,8" FontSize="13" Margin="0,0,10,0"
                        Click="Cancel_Click"/>
                <Button Content="确认退出" Style="{StaticResource NavBtn}" Padding="16,8" FontSize="13"
                        Background="#5C1F1F" BorderBrush="#E5534B"
                        Click="Confirm_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
