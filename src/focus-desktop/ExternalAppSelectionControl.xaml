<UserControl x:Class="focus_desktop.ExternalAppSelectionControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="520" MinHeight="300">
    <UserControl.Resources>
        <SolidColorBrush x:Key="AppText" Color="#F0F4FF"/>
        <SolidColorBrush x:Key="AppMuted" Color="#9AA0A6"/>
        <SolidColorBrush x:Key="AppBorder" Color="#454B55"/>
        <SolidColorBrush x:Key="AppSurface" Color="#292D34"/>
        <SolidColorBrush x:Key="AppButton" Color="#343A44"/>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="选择专注期间可使用的软件" FontSize="22" FontWeight="Bold" Foreground="{StaticResource AppText}"/>
            <TextBlock Text="可跳过此步，仅使用学习桌面，不显示软件侧栏。软件名单确认后冻结，修改设置需卸载后重新安装，卸载会清除应用数据。同一应用只能选择一个入口；已有窗口优先复用，不保证切到指定项目或文档。"
                       Margin="0,6,0,0" FontSize="13" TextWrapping="Wrap" Foreground="{StaticResource AppMuted}"/>
        </StackPanel>

        <Border Grid.Row="1" Background="{StaticResource AppSurface}" BorderBrush="{StaticResource AppBorder}"
                BorderThickness="1" CornerRadius="10" Padding="8">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="EntriesPanel"/>
            </ScrollViewer>
        </Border>

        <Border Grid.Row="2" Margin="0,8,0,0" Padding="10,7" CornerRadius="8"
                Background="#332E2525" BorderBrush="#665B4747" BorderThickness="1"
                Visibility="Collapsed" x:Name="ErrorPanel">
            <ScrollViewer MaxHeight="62" VerticalScrollBarVisibility="Auto">
                <TextBlock x:Name="ErrorText" FontSize="12" TextWrapping="Wrap" Foreground="#E7B2AE"/>
            </ScrollViewer>
        </Border>

        <Grid Grid.Row="3" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="CountText" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource AppMuted}"/>
            <Button x:Name="BrowseButton" Grid.Column="1" Content="浏览其他位置…" Padding="16,8" MinHeight="36"
                    Background="{StaticResource AppButton}" Foreground="{StaticResource AppText}"
                    BorderBrush="{StaticResource AppBorder}" BorderThickness="1" Cursor="Hand"
                    Click="Browse_Click" IsEnabled="False" AutomationProperties.AutomationId="ExternalAppsBrowseButton"/>
        </Grid>
    </Grid>
</UserControl>
