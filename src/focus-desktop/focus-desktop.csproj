<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>focus-desktop</AssemblyName>
    <RootNamespace>focus_desktop</RootNamespace>
    <Version>1.1.3</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\..\assets\focus.ico</ApplicationIcon>
    <!-- 双布局（Public v1）：portable.flag 存在 → 数据在 exe 旁；否则 %LOCALAPPDATA%\focus-desktop -->
    <SatelliteResourceLanguages>zh-Hans;en</SatelliteResourceLanguages>
    <Product>Focus Desk</Product>
    <Description>专注学习环境（Soft Kiosk）：白名单浏览器 + 学习文件 + 番茄钟</Description>
    <Copyright>MIT License</Copyright>
    <AssemblyVersion>1.1.3.0</AssemblyVersion>
    <FileVersion>1.1.3.0</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4191.47" />
  </ItemGroup>

</Project>
